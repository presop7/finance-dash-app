# Postgres connection string. Point this at your real hosted Postgres (e.g. a
# Supabase project's Postgres) in production; a local Docker container is fine
# for development, but never hardcode a connection string in code.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/finance_dash

# Supabase project URL — used to verify auth JWTs against the project's
# public JWKS endpoint. No secret key needed here (verification uses the
# project's public signing key, fetched over HTTPS).
SUPABASE_URL=https://your-project-ref.supabase.co

# Comma-separated allowed CORS origins for browser clients (e.g. the Expo web
# build). Optional — defaults to "*" if unset, since this API is Bearer-token
# authenticated (no cookies), so a wide-open policy carries no CSRF risk.
CORS_ORIGINS=*

# In-app feedback emails (POST /feedback) go out through Resend's HTTP API
# (Render blocks outbound SMTP on free instances). Optional: leave unset and
# the endpoint answers 503 instead of the app failing to start.
# Create a key at resend.com/api-keys — keep it out of chat/screenshots, and
# rotate it if it ever leaks.
RESEND_API_KEY=
# Where reports are delivered. Until you verify a domain in Resend, its
# sandbox sender (onboarding@resend.dev) only delivers to the Resend account
# owner's own email, so use that address here.
FEEDBACK_TO_EMAIL=you@example.com
# Optional; defaults to Resend's sandbox sender.
FEEDBACK_FROM_EMAIL=Finance Dash Feedback <onboarding@resend.dev>

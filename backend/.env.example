# Postgres connection string. Point this at your real hosted Postgres (e.g. a
# Supabase project's Postgres) in production; a local Docker container is fine
# for development, but never hardcode a connection string in code.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/finance_dash

# Supabase project URL — used to verify auth JWTs against the project's
# public JWKS endpoint. No secret key needed here (verification uses the
# project's public signing key, fetched over HTTPS).
SUPABASE_URL=https://your-project-ref.supabase.co

# Comma-separated allowed CORS origins for browser clients (e.g. the Expo web
# build). Optional — defaults to "*" if unset, since this API is Bearer-token
# authenticated (no cookies), so a wide-open policy carries no CSRF risk.
CORS_ORIGINS=*

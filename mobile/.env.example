EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The deployed backend (works from any network). For local backend development:
#   web / iOS simulator on the same machine: http://localhost:8000
#   Android emulator:                        http://10.0.2.2:8000
#   physical device on the same LAN:         http://<your-machine-lan-ip>:8000
EXPO_PUBLIC_API_URL=https://your-service.onrender.com

# Optional: show developer-only tools (test-data buttons, perf badge) in a
# dev client run with --no-dev. Leave unset for anything testers get.
# EXPO_PUBLIC_DEV_TOOLS=true

# Web version payments through Paddle (see docs/billing-setup.md). Unset =
# off: the Premium screen sends people to the Android app (PLAY_STORE_URL)
# or says payments are coming. All of these are public values.
# EXPO_PUBLIC_PADDLE_ENV=sandbox
# EXPO_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
# EXPO_PUBLIC_PADDLE_PRICE_MONTHLY=pri_...
# EXPO_PUBLIC_PADDLE_PRICE_YEARLY=pri_...
# EXPO_PUBLIC_PADDLE_DISCOUNT_TRIAL=dsc_...
# EXPO_PUBLIC_PADDLE_DISCOUNT_MILESTONE=dsc_...
# EXPO_PUBLIC_PADDLE_DISCOUNT_TRIAL_END=dsc_...
